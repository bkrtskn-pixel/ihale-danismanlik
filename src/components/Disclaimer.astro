---
import Icon from './Icon.astro';
import { officialSources } from '@/data/site';

interface Props {
  text: string;
  showSources?: boolean;
  class?: string;
}
const { text, showSources = true, class: className = '' } = Astro.props;
---

<aside class:list={['flex gap-4 rounded-sm border border-line bg-paper p-6 sm:p-7', className]} aria-label="Bilgilendirme notu">
  <Icon name="info" class="mt-0.5 size-5 shrink-0 text-gold-700" />
  <div class="text-[0.93rem] leading-relaxed text-muted-strong">
    <p>{text}</p>
    {
      showSources && (
        <p class="mt-3">
          Mevzuatın güncel hâli için resmî kaynaklar:{' '}
          <a href={officialSources.kik.url} target="_blank" rel="noopener noreferrer" class="font-medium text-navy-900 underline decoration-gold-500 underline-offset-4">
            {officialSources.kik.label}
          </a>
          ,{' '}
          <a href={officialSources.ekap.url} target="_blank" rel="noopener noreferrer" class="font-medium text-navy-900 underline decoration-gold-500 underline-offset-4">
            EKAP
          </a>{' '}
          ve{' '}
          <a href={officialSources.mevzuat.url} target="_blank" rel="noopener noreferrer" class="font-medium text-navy-900 underline decoration-gold-500 underline-offset-4">
            {officialSources.mevzuat.label}
          </a>
          .
        </p>
      )
    }
  </div>
</aside>
