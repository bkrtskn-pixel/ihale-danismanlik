---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TechCover from '@/components/TechCover.astro';
import Toc from '@/components/Toc.astro';
import Icon from '@/components/Icon.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getService } from '@/data/services';
import { site } from '@/data/site';
import { absoluteUrl, href } from '@/lib/paths';
import { readingTime } from '@/lib/reading-time';
import { breadcrumbSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const minutes = readingTime(article.body);
const service = getService(article.data.relatedService);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));

const others = (await getCollection('articles', ({ data, id }) => !data.draft && id !== article.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const crumbs = [
  { label: 'Ana Sayfa', path: '/' },
  { label: 'Bilgi Merkezi', path: '/bilgi-merkezi/' },
  { label: article.data.title, path: `/bilgi-merkezi/${article.id}/` },
];

const orgId = `${absoluteUrl(href('/'), Astro.site)}#organization`;
const articleSchema = {
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  inLanguage: 'tr-TR',
  mainEntityOfPage: absoluteUrl(href(`/bilgi-merkezi/${article.id}/`), Astro.site),
  author: { '@id': orgId, name: site.brand.name },
  publisher: { '@id': orgId, name: site.brand.name },
  timeRequired: `PT${minutes}M`,
};
---

<BaseLayout title={article.data.title} description={article.data.description} type="article" schema={[breadcrumbSchema(crumbs, Astro.site), articleSchema]}>
  <article>
    <header class="on-dark relative isolate overflow-hidden bg-navy-900 pt-[calc(var(--header-h)+3.5rem)] pb-16 text-white lg:pt-[calc(var(--header-h)+5rem)] lg:pb-20">
      <div class="bg-grid-dark absolute inset-0 -z-10 [mask-image:linear-gradient(180deg,black,transparent_95%)]" aria-hidden="true"></div>
      <div class="container-x">
        <Breadcrumbs items={crumbs} />
        <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <p class="eyebrow hero-rise">Bilgi Merkezi · Rehber</p>
            <h1 class="hero-rise mt-6 font-display text-[clamp(2rem,1.3rem+2.8vw,3.4rem)] leading-[1.08] font-bold tracking-[-0.03em] text-white" style="--rise-delay:80ms">
              {article.data.title}
            </h1>
            <p class="hero-rise mt-7 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.88rem] text-white/70" style="--rise-delay:160ms">
              <span class="inline-flex items-center gap-2"><Icon name="clock" class="size-4 text-gold-500" />{minutes} dk okuma</span>
              {
                service && (
                  <span class="inline-flex items-center gap-2">
                    <Icon name="book" class="size-4 text-gold-500" />
                    {service.title}
                  </span>
                )
              }
            </p>
          </div>
          <div class="hero-rise lg:col-span-5" style="--rise-delay:240ms">
            <TechCover variant={article.data.cover} class="aspect-[16/10] w-full rounded-sm border border-white/10" />
          </div>
        </div>
      </div>
    </header>

    <div class="on-light container-x grid gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2.5rem)]">
          <Toc items={toc} title="İçindekiler" />
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-8 lg:col-start-5">
        <div class="border-l-2 border-gold-500 pl-6">
          <p class="font-display text-xs font-semibold tracking-[0.18em] text-gold-700 uppercase">Özet</p>
          <p class="mt-3 text-lg leading-relaxed text-ink sm:text-xl">{article.data.summary}</p>
        </div>

        <details class="mt-10 rounded-sm border border-line p-5 lg:hidden">
          <summary class="cursor-pointer font-display font-semibold text-navy-900">İçindekiler</summary>
          <ol class="mt-4 space-y-2 text-[0.95rem]">
            {toc.map((t) => <li><a href={`#${t.id}`} class="text-muted hover:text-navy-900">{t.label}</a></li>)}
          </ol>
        </details>

        <div class="prose-x mt-12">
          <Content />
        </div>

        <section aria-labelledby="kaynaklar" class="mt-16 rounded-sm border border-line bg-paper p-7 sm:p-8">
          <h2 id="kaynaklar" class="font-display text-lg font-bold">Resmî kaynaklar</h2>
          <p class="mt-2 text-[0.93rem] leading-relaxed text-muted-strong">
            Mevzuatın ve platform iş akışlarının güncel hâlini aşağıdaki resmî kaynaklardan kontrol ediniz.
          </p>
          <ul class="mt-5 space-y-3">
            {
              article.data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 font-medium text-navy-900">
                    <Icon name="external" class="size-4 text-gold-700" />
                    <span class="underline decoration-line-strong underline-offset-4 transition-colors group-hover:decoration-navy-900">{s.label}</span>
                    <span class="sr-only">(yeni sekmede açılır)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        {
          service && (
            <aside aria-labelledby="ilgili-hizmet" class="on-dark relative mt-8 overflow-hidden rounded-sm bg-navy-900 p-7 text-white sm:p-8">
              <div class="bg-grid-dark absolute inset-0" aria-hidden="true" />
              <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="eyebrow">İlgili hizmet</p>
                  <h2 id="ilgili-hizmet" class="mt-3 font-display text-xl font-bold text-white">{service.title}</h2>
                </div>
                <a href={href(`/hizmetler/${service.slug}/`)} class="btn btn-primary shrink-0">
                  Hizmeti İnceleyin
                  <Icon name="arrow-right" />
                </a>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section on-light border-t border-line bg-paper" aria-labelledby="diger-yazilar">
        <div class="container-x">
          <h2 id="diger-yazilar" class="h-section">Diğer rehber içerikler</h2>
          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {others.map((a, i) => <ArticleCard article={a} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
