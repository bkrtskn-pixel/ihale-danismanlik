---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import Faq from '@/components/Faq.astro';
import Toc from '@/components/Toc.astro';
import CtaBand from '@/components/CtaBand.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { services, serviceDisclaimer, type Service } from '@/data/services';
import { site } from '@/data/site';
import { absoluteUrl, href } from '@/lib/paths';
import { breadcrumbSchema, faqSchema } from '@/lib/schema';

export const getStaticPaths = (() =>
  services.map((service, index) => ({
    params: { slug: service.slug },
    props: { service, index },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const prev = services[(index - 1 + services.length) % services.length];
const next = services[(index + 1) % services.length];

const related = (await getCollection('articles', ({ data }) => !data.draft && data.relatedService === service.slug));

const crumbs = [
  { label: 'Ana Sayfa', path: '/' },
  { label: 'Hizmetlerimiz', path: '/hizmetler/' },
  { label: service.title, path: `/hizmetler/${service.slug}/` },
];

const sections = [
  { id: 'ozet', label: 'Hizmet özeti' },
  { id: 'konular', label: 'Değerlendirilen konular' },
  { id: 'kapsam', label: 'Hizmetin kapsamı' },
  { id: 'yontem', label: 'Çalışma yöntemi' },
  { id: 'ihtiyaclar', label: 'Kimler için uygun?' },
  { id: 'sss', label: 'Sık sorulan sorular' },
];

const serviceSchema = {
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  serviceType: 'Kamu ihale danışmanlığı',
  url: absoluteUrl(href(`/hizmetler/${service.slug}/`), Astro.site),
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  provider: { '@id': `${absoluteUrl(href('/'), Astro.site)}#organization`, name: site.brand.name },
};
---

<BaseLayout
  title={service.title}
  description={service.metaDescription}
  schema={[breadcrumbSchema(crumbs, Astro.site), serviceSchema, faqSchema(service.faqs)]}
>
  <PageHero breadcrumbs={crumbs} index={service.number} eyebrow="Hizmet" title={service.title} lead={service.lead}>
    <div class="hero-rise mt-10 flex flex-col gap-3 sm:flex-row" style="--rise-delay:240ms">
      <a href={href('/iletisim/')} class="btn btn-primary">
        Danışmanlık Talep Et
        <Icon name="arrow-right" />
      </a>
      <a href="#kapsam" class="btn btn-ghost-dark">Kapsamı İnceleyin</a>
    </div>
    <div slot="aside" class="hidden lg:block">
      <div class="relative ml-auto aspect-square w-full max-w-[340px] rounded-sm border border-white/12">
        <div class="bg-grid-dark absolute inset-0" aria-hidden="true"></div>
        <div class="absolute inset-[18%] rounded-full border border-white/10" aria-hidden="true"></div>
        <div class="absolute inset-[32%] rounded-full border border-gold-500/40" aria-hidden="true"></div>
        <div class="absolute inset-0 flex items-center justify-center text-gold-500" aria-hidden="true">
          <Icon name={service.icon} class="size-24" strokeWidth={0.9} />
        </div>
        <span class="absolute top-4 left-4 font-mono text-xs text-white/50">{service.number} / {String(services.length).padStart(2, '0')}</span>
        <span class="absolute right-4 bottom-4 font-mono text-[0.7rem] tracking-[0.14em] text-white/40 uppercase">Hizmet alanı</span>
      </div>
    </div>
  </PageHero>

  <div class="on-light">
    <div class="container-x grid gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2.5rem)]">
          <Toc items={sections} />
          <a href={href('/iletisim/')} class="btn btn-navy mt-10 w-full text-[0.88rem]">Ön görüşme talep et</a>
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-9 lg:pl-8">
        <!-- Özet -->
        <section id="ozet" aria-labelledby="ozet-baslik" class="scroll-mt-28">
          <p class="eyebrow" data-reveal>Hizmet özeti</p>
          <h2 id="ozet-baslik" class="h-section mt-5 max-w-3xl" data-reveal>Bu hizmet ne sağlar?</h2>
          <div class="mt-8 max-w-3xl space-y-5 text-[1.0625rem] leading-[1.75] text-ink" data-reveal>
            {service.overview.map((p) => <p>{p}</p>)}
          </div>
        </section>

        <!-- Konular -->
        <section id="konular" aria-labelledby="konular-baslik" class="mt-24 scroll-mt-28">
          <p class="eyebrow" data-reveal>Değerlendirilen konular</p>
          <h2 id="konular-baslik" class="h-section mt-5 max-w-3xl" data-reveal>Hangi konular ele alınır?</h2>
          <ol class="mt-10 grid gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-2">
            {
              service.topics.map((t, i) => (
                <li class="bg-white p-7 transition-colors duration-300 hover:bg-paper sm:[&:last-child:nth-child(odd)]:col-span-2" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
                  <span class="num-tag">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="mt-3 font-display text-lg font-semibold text-navy-900">{t.title}</h3>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{t.text}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- Kapsam -->
        <section id="kapsam" aria-labelledby="kapsam-baslik" class="mt-24 scroll-mt-28">
          <div class="on-dark relative overflow-hidden rounded-sm bg-navy-900 p-8 text-white sm:p-12" data-reveal>
            <div class="bg-grid-dark absolute inset-0" aria-hidden="true"></div>
            <div class="relative grid gap-10 lg:grid-cols-5">
              <div class="lg:col-span-2">
                <p class="eyebrow">Hizmetin kapsamı</p>
                <h2 id="kapsam-baslik" class="mt-5 font-display text-2xl font-bold text-white sm:text-3xl">Çalışma sonunda sunulanlar</h2>
                <p class="mt-4 text-[0.95rem] leading-relaxed text-white/70">
                  Kapsam, ön görüşmede ihtiyaca göre birlikte belirlenir. Aşağıdaki çıktılar bu hizmetin tipik bileşenleridir.
                </p>
              </div>
              <ul class="space-y-4 lg:col-span-3">
                {
                  service.scope.map((s) => (
                    <li class="flex items-start gap-4 border-b border-white/10 pb-4 last:border-0 last:pb-0">
                      <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-gold-500/60 text-gold-500">
                        <Icon name="check" class="size-3.5" strokeWidth={2.25} />
                      </span>
                      <span class="text-[1rem] text-white/90">{s}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>

        <!-- Yöntem -->
        <section id="yontem" aria-labelledby="yontem-baslik" class="mt-24 scroll-mt-28">
          <p class="eyebrow" data-reveal>Çalışma yöntemi</p>
          <h2 id="yontem-baslik" class="h-section mt-5 max-w-3xl" data-reveal>Nasıl çalışıyoruz?</h2>
          <ol class="mt-10 space-y-0 border-t border-line">
            {
              service.method.map((m, i) => (
                <li class="grid gap-3 border-b border-line py-7 sm:grid-cols-12 sm:gap-6" data-reveal>
                  <span class="font-display text-3xl font-bold text-gold-700 sm:col-span-2">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="font-display text-lg font-semibold text-navy-900 sm:col-span-4">{m.title}</h3>
                  <p class="text-[0.97rem] leading-relaxed text-muted sm:col-span-6">{m.text}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- İhtiyaçlar -->
        <section id="ihtiyaclar" aria-labelledby="ihtiyac-baslik" class="mt-24 scroll-mt-28">
          <p class="eyebrow" data-reveal>Hedeflenen ihtiyaçlar</p>
          <h2 id="ihtiyac-baslik" class="h-section mt-5 max-w-3xl" data-reveal>Kimler için uygun?</h2>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2">
            {
              service.needs.map((n, i) => (
                <li class="card flex gap-4 p-6" data-reveal style={`--reveal-delay:${(i % 2) * 70}ms`}>
                  <span class="mt-1 h-px w-6 shrink-0 bg-gold-500" aria-hidden="true" />
                  <span class="text-[0.98rem] leading-relaxed text-ink">{n}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- SSS -->
        <section id="sss" aria-labelledby="sss-baslik" class="mt-24 scroll-mt-28">
          <p class="eyebrow" data-reveal>SSS</p>
          <h2 id="sss-baslik" class="h-section mt-5 mb-10" data-reveal>Sık sorulan sorular</h2>
          <Faq items={service.faqs} />
        </section>

        <Disclaimer text={serviceDisclaimer} class="mt-14" />

        {
          related.length > 0 && (
            <section aria-labelledby="ilgili-baslik" class="mt-20">
              <h2 id="ilgili-baslik" class="font-display text-xl font-bold">İlgili rehber içerik</h2>
              <div class="mt-6 grid gap-6 md:grid-cols-2">
                {related.map((a) => <ArticleCard article={a} />)}
              </div>
            </section>
          )
        }

        <!-- Önceki / sonraki hizmet -->
        <nav aria-label="Diğer hizmetler" class="mt-20 grid gap-4 border-t border-line pt-10 sm:grid-cols-2">
          <a href={href(`/hizmetler/${prev.slug}/`)} class="group card card-hover p-6">
            <span class="text-[0.8rem] text-muted">Önceki hizmet</span>
            <span class="mt-2 block font-display font-semibold text-navy-900">{prev.title}</span>
          </a>
          <a href={href(`/hizmetler/${next.slug}/`)} class="group card card-hover p-6 sm:text-right">
            <span class="text-[0.8rem] text-muted">Sonraki hizmet</span>
            <span class="mt-2 block font-display font-semibold text-navy-900">{next.title}</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <CtaBand
    title="Bu hizmet için ön görüşme talep edin."
    text="İhalenizin ya da sözleşmenizin kapsamını kısaca paylaşın; ihtiyacınızı ve çalışma kapsamını birlikte netleştirelim."
  />
</BaseLayout>
