---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { aboutIntro, aboutPillars, serviceBoundaries, company } from '@/data/about';
import { processSteps } from '@/data/home';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { label: 'Ana Sayfa', path: '/' },
  { label: 'Hakkımızda', path: '/hakkimizda/' },
];
---

<BaseLayout
  title="Hakkımızda"
  description="Kamu yapım işi ihalelerinde doküman odaklı inceleme, teknik ve analitik yaklaşım, şeffaflık, süreç yönetimi ve gizlilik ilkeleriyle çalışan danışmanlık anlayışımız."
  schema={[breadcrumbSchema(crumbs, Astro.site), { '@type': 'AboutPage', name: 'Hakkımızda', inLanguage: 'tr-TR' }]}
>
  <PageHero breadcrumbs={crumbs} eyebrow="Hakkımızda" title={aboutIntro.title} lead={aboutIntro.lead} />

  {
    company.story && (
      <section class="section on-light" aria-labelledby="hikaye-baslik">
        <div class="container-x grid gap-10 lg:grid-cols-12">
          <h2 id="hikaye-baslik" class="h-section lg:col-span-4">Kurumsal bilgiler</h2>
          <p class="text-lg leading-relaxed text-muted lg:col-span-7 lg:col-start-6">{company.story}</p>
        </div>
      </section>
    )
  }

  <!-- İlkeler -->
  <section class="section on-light" aria-labelledby="ilkeler-baslik">
    <div class="container-x">
      <SectionHeading
        id="ilkeler-baslik"
        eyebrow="Çalışma ilkelerimiz"
        title="Danışmanlığı belirleyen altı temel ilke"
        lead="Her çalışmada aynı disiplinle uyguladığımız ilkeler; hizmetin kapsamını, raporlama biçimini ve firmanızla kurduğumuz ilişkiyi belirler."
        align="split"
      />
      <div class="mt-16 grid gap-px overflow-hidden rounded-sm border border-line bg-line md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
        {
          aboutPillars.map((p, i) => (
            <section id={p.id} aria-labelledby={`${p.id}-baslik`} class="group flex flex-col bg-white p-8 transition-colors duration-500 hover:bg-paper sm:p-10" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <div class="flex items-center justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-sm bg-navy-900 text-gold-500">
                  <Icon name={p.icon} class="size-6" />
                </span>
                <span class="num-tag">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 id={`${p.id}-baslik`} class="h-card mt-8">{p.title}</h3>
              <p class="mt-4 text-[0.97rem] leading-relaxed text-muted">{p.text}</p>
              <ul class="mt-6 space-y-2 border-t border-line pt-6 text-[0.9rem] text-ink">
                {p.points.map((pt) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-gold-700" strokeWidth={2} />
                    {pt}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Hizmet sınırları -->
  <section class="section on-light bg-paper" aria-labelledby="sinirlar-baslik">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Şeffaflık</p>
        <h2 id="sinirlar-baslik" class="h-section mt-5">{serviceBoundaries.title}</h2>
        <p class="lead mt-6">{serviceBoundaries.lead}</p>
      </div>
      <ul class="space-y-4 lg:col-span-6 lg:col-start-7">
        {
          serviceBoundaries.items.map((item, i) => (
            <li class="card flex items-start gap-5 p-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="num-tag mt-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[1rem] leading-relaxed text-ink">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Süreç özeti -->
  <section class="section on-light" aria-labelledby="surec-ozet">
    <div class="container-x">
      <SectionHeading id="surec-ozet" eyebrow="Süreç" title="Bir danışmanlık çalışması nasıl ilerler?" />
      <ol class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((s, i) => (
            <li class="bg-white p-8" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="font-display text-4xl font-bold text-gold-700">{s.number}</span>
              <h3 class="mt-6 font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    company.team.length > 0 && (
      <section class="section on-light bg-paper" aria-labelledby="ekip-baslik">
        <div class="container-x">
          <SectionHeading id="ekip-baslik" eyebrow="Ekip" title="Ekibimiz" />
          <ul class="mt-12 grid gap-6 md:grid-cols-3">
            {company.team.map((m) => (
              <li class="card p-8">
                <h3 class="h-card">{m.name}</h3>
                <p class="mt-1 text-sm text-gold-700">{m.role}</p>
                <p class="mt-4 text-[0.95rem] text-muted">{m.bio}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
