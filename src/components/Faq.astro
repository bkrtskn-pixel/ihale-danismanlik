---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((item, i) => (
      <details class="faq group" name="sss" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 font-display text-lg font-semibold text-navy-900 transition-colors hover:text-navy-700 [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line text-navy-900 transition-transform duration-300 group-open:rotate-180 group-open:border-navy-900">
            <Icon name="chevron-down" class="size-4" />
          </span>
        </summary>
        <div class="faq-body">
          <p class="max-w-3xl pb-7 text-[1rem] leading-relaxed text-muted">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.4s var(--ease-out-soft),
        content-visibility 0.4s allow-discrete;
    }
    .faq[open]::details-content {
      block-size: auto;
    }
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
