---
import { site } from '@/data/site';
import { absoluteUrl, asset } from '@/lib/paths';

export interface SEOProps {
  title: string;
  description: string;
  /** Sosyal paylaşım görseli (public/ altındaki yol). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image = 'images/og/og-default.png', imageAlt, type = 'website', noindex = false } = Astro.props as SEOProps;

const fullTitle = title === site.brand.name ? `${site.brand.name} — ${site.brand.tagline}` : `${title} | ${site.brand.name}`;
const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(asset(image), Astro.site);
const robots = noindex || site.prototype.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.brand.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? site.brand.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? site.brand.name} />
