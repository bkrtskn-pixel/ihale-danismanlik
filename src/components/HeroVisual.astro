---
// Ana sayfa hero kompozisyonu: kamu binası ön görünüşü + ölçü çizgileri +
// doküman kontrol kartı. Tamamen SVG/CSS ile üretilmiştir (harici görsel yok).
import Icon from './Icon.astro';

const piers = [168, 200, 232, 264, 296, 328, 360, 392];
const checklist = ['İdari şartname', 'Teknik şartname', 'Sözleşme tasarısı', 'Birim fiyat cetveli', 'Zeyilnameler'];
---

<figure class="relative mx-auto w-full max-w-[560px]" aria-label="Kamu binası teknik çizimi ve ihale dokümanı kontrol listesinden oluşan soyut kompozisyon">
  <div class="relative aspect-[560/520] w-full">
    <svg viewBox="0 0 560 520" class="absolute inset-0 h-full w-full" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hv-grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="#FFFFFF" stroke-opacity=".05" />
        </pattern>
        <linearGradient id="hv-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".09" />
          <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- çizim paftası -->
      <rect x="20.5" y="20.5" width="519" height="479" fill="url(#hv-grid)" stroke="#FFFFFF" stroke-opacity=".14" />
      <rect x="32.5" y="32.5" width="495" height="455" fill="none" stroke="#FFFFFF" stroke-opacity=".06" />

      <g class="hero-draw" fill="none" stroke="#FFFFFF" stroke-linecap="square">
        <!-- zemin -->
        <line x1="60" y1="404" x2="500" y2="404" stroke-opacity=".7" stroke-width="1.5" />
        <!-- basamaklar -->
        <polyline points="120,404 120,394 136,394 136,384 424,384 424,394 440,394 440,404" stroke-opacity=".55" />
        <!-- gövde -->
        <rect x="150" y="214" width="260" height="170" stroke-opacity=".75" stroke-width="1.25" />
        <!-- konsol çatı döşemesi -->
        <rect x="104" y="196" width="352" height="18" stroke-opacity=".9" stroke-width="1.5" />
        <!-- çatı katı -->
        <rect x="196" y="164" width="168" height="32" stroke-opacity=".6" />
        <line x1="196" y1="180" x2="364" y2="180" stroke-opacity=".25" />
        <!-- giriş -->
        <rect x="258" y="300" width="44" height="84" stroke-opacity=".7" />
        <line x1="280" y1="300" x2="280" y2="384" stroke-opacity=".35" />
      </g>

      <!-- cephe ayakları -->
      <g fill="url(#hv-fade)" stroke="#FFFFFF" stroke-opacity=".5">
        {piers.map((x) => <rect x={x - 4} y={228} width="8" height="156" />)}
      </g>
      <g stroke="#FFFFFF" stroke-opacity=".14">
        <line x1="150" y1="262" x2="410" y2="262" />
        <line x1="150" y1="300" x2="410" y2="300" />
        <line x1="150" y1="338" x2="410" y2="338" />
      </g>

      <g class="hero-fade">
        <!-- üst ölçü çizgisi -->
        <g stroke="#FFFFFF" stroke-opacity=".45">
          <line x1="104" y1="140" x2="456" y2="140" />
          <line x1="104" y1="132" x2="104" y2="190" stroke-dasharray="2 3" />
          <line x1="456" y1="132" x2="456" y2="190" stroke-dasharray="2 3" />
          <line x1="99" y1="145" x2="109" y2="135" />
          <line x1="451" y1="145" x2="461" y2="135" />
        </g>
        <text x="280" y="132" text-anchor="middle" fill="#FFFFFF" fill-opacity=".6" font-family="ui-monospace, Menlo, monospace" font-size="10" letter-spacing="1">L = 44.00</text>

        <!-- sol düşey ölçü -->
        <g stroke="#FFFFFF" stroke-opacity=".45">
          <line x1="72" y1="196" x2="72" y2="404" />
          <line x1="67" y1="201" x2="77" y2="191" />
          <line x1="67" y1="409" x2="77" y2="399" />
        </g>
        <text x="62" y="300" text-anchor="middle" fill="#FFFFFF" fill-opacity=".6" font-family="ui-monospace, Menlo, monospace" font-size="10" letter-spacing="1" transform="rotate(-90 62 300)">H = 13.20</text>

        <!-- kot işaretleri -->
        <g fill="#C4A46A">
          <path d="M470 404l-6-9h12z" />
          <path d="M470 196l-6-9h12z" />
        </g>
        <g fill="#FFFFFF" fill-opacity=".7" font-family="ui-monospace, Menlo, monospace" font-size="10" letter-spacing=".5">
          <text x="482" y="400">±0.00</text>
          <text x="482" y="192">+13.20</text>
        </g>
        <line x1="462" y1="404" x2="478" y2="404" stroke="#C4A46A" />
        <line x1="462" y1="196" x2="478" y2="196" stroke="#C4A46A" />

        <!-- kesit çizgisi A-A -->
        <line x1="344" y1="108" x2="344" y2="440" stroke="#C4A46A" stroke-dasharray="10 4 2 4" stroke-opacity=".9" />
        <g fill="#10243A" stroke="#C4A46A" stroke-width="1.25">
          <circle cx="344" cy="96" r="11" />
          <circle cx="344" cy="452" r="11" />
        </g>
        <g fill="#C4A46A" font-family="Manrope Variable, sans-serif" font-size="11" font-weight="700" text-anchor="middle">
          <text x="344" y="100">A</text>
          <text x="344" y="456">A</text>
        </g>

        <!-- başlık bloğu -->
        <g font-family="ui-monospace, Menlo, monospace" font-size="9" letter-spacing="1.4" fill="#FFFFFF">
          <text x="52" y="66" fill-opacity=".55">ÖN GÖRÜNÜŞ</text>
          <text x="52" y="80" fill-opacity=".35">ÖLÇEK 1/200</text>
        </g>
        <line x1="52" y1="88" x2="148" y2="88" stroke="#C4A46A" stroke-opacity=".8" />
      </g>
    </svg>

  </div>
    <!-- doküman kontrol kartı -->
    <div
      class="hero-rise relative z-10 -mt-[12%] ml-auto w-[82%] rounded-sm border border-white/15 bg-navy-800/95 p-4 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.7)] backdrop-blur-md sm:absolute sm:right-[-6%] sm:bottom-[2%] sm:mt-0 sm:w-[58%] sm:min-w-[220px] sm:p-5"
      style="--rise-delay:900ms"
    >
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <p class="font-display text-[0.72rem] font-semibold tracking-[0.16em] text-gold-500 uppercase">Doküman kontrolü</p>
        <Icon name="document-search" class="size-4 text-white/60" />
      </div>
      <ul class="mt-3 space-y-2 text-[0.8rem] text-white/80 sm:text-[0.84rem]">
        {
          checklist.map((item) => (
            <li class="flex items-center gap-2.5">
              <span class="inline-flex size-4 shrink-0 items-center justify-center rounded-[2px] border border-gold-500/70 text-gold-500">
                <Icon name="check" class="size-3" strokeWidth={2.5} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  <figcaption class="sr-only">Soyut teknik çizim: kamu binası ön görünüşü, ölçü ve kot işaretleri ile ihale dokümanı kontrol listesi.</figcaption>
</figure>
