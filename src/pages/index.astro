---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { hero, approach, processSteps } from '@/data/home';
import { services } from '@/data/services';
import { href } from '@/lib/paths';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={site.brand.name} description={site.description}>
  <!-- HERO -->
  <section class="on-dark relative isolate overflow-hidden bg-navy-900 text-white" aria-labelledby="hero-baslik">
    <div class="bg-grid-dark absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_70%_40%,black_30%,transparent_80%)]" aria-hidden="true"></div>
    <div
      class="absolute top-1/3 -right-1/4 -z-10 size-[780px] rounded-full bg-[radial-gradient(circle,rgb(196_164_106/0.13),transparent_62%)]"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-y-0 left-[max(1.25rem,calc((100vw-1240px)/2+2.5rem))] -z-10 hidden w-px bg-white/[0.06] xl:block" aria-hidden="true"></div>

    <div class="container-x grid items-center gap-14 pt-[calc(var(--header-h)+3.5rem)] pb-16 lg:min-h-[min(92vh,880px)] lg:grid-cols-12 lg:gap-8 lg:pt-[calc(var(--header-h)+4rem)] lg:pb-20">
      <div class="lg:col-span-7">
        <p class="eyebrow hero-rise">{hero.eyebrow}</p>
        <h1 id="hero-baslik" class="hero-rise mt-7 font-display text-[clamp(2.4rem,1.2rem+4vw,4.25rem)] leading-[1.04] font-bold tracking-[-0.035em] text-white" style="--rise-delay:90ms">
          <span class="block">{hero.titleLines[0]}</span>
          <span class="block text-gold-500">{hero.titleLines[1]}</span>
        </h1>
        <p class="lead hero-rise mt-8 max-w-xl" style="--rise-delay:180ms">{hero.lead}</p>
        <div class="hero-rise mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--rise-delay:270ms">
          <a href={href(hero.primaryCta.path)} class="btn btn-primary">
            {hero.primaryCta.label}
            <Icon name="arrow-right" />
          </a>
          <a href={href(hero.secondaryCta.path)} class="btn btn-ghost-dark">
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <HeroVisual />
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="container-x">
        <ul class="flex flex-wrap gap-x-8 gap-y-3 py-6 text-[0.82rem] text-white/60" aria-label="Çalışma alanları">
          {
            hero.facets.map((f, i) => (
              <li class="flex items-center gap-3">
                <span class="font-mono text-[0.7rem] text-gold-500">{String(i + 1).padStart(2, '0')}</span>
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- GÜVEN VE UZMANLIK -->
  <section class="section on-light" aria-labelledby="yaklasim-baslik">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-5" data-reveal>
          <p class="eyebrow">{approach.eyebrow}</p>
          <h2 id="yaklasim-baslik" class="h-section mt-5">{approach.title}</h2>
        </div>
        <div class="space-y-5 text-[1.05rem] leading-relaxed text-muted lg:col-span-6 lg:col-start-7 lg:pt-12" data-reveal style="--reveal-delay:100ms">
          {approach.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid border-t border-line sm:grid-cols-2 lg:mt-24 lg:grid-cols-4">
        {
          approach.principles.map((p, i) => (
            <li
              class:list={[
                'group relative border-b border-line py-10 sm:px-8 lg:border-b-0',
                i % 2 === 1 && 'sm:border-l',
                i > 0 && 'lg:border-l',
                'sm:first:pl-0 lg:px-8 lg:first:pl-0',
              ]}
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span class="absolute top-[-1px] left-0 h-0.5 w-10 bg-gold-500 transition-[width] duration-700 group-hover:w-24 sm:left-8 sm:group-first:left-0 lg:left-8 lg:group-first:left-0" aria-hidden="true" />
              <span class="num-tag">{p.number}</span>
              <h3 class="h-card mt-5">{p.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- HİZMETLER -->
  <section class="section on-light bg-paper" aria-labelledby="hizmetler-baslik">
    <div class="container-x">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="hizmetler-baslik"
          eyebrow="Hizmetlerimiz"
          title="İhalenin her aşaması için uzmanlaşmış danışmanlık"
          lead="Doküman incelemesinden sözleşme dönemine kadar, yapım işi ihale sürecinin farklı aşamalarına yönelik altı hizmet alanı."
        />
        <a href={href('/hizmetler/')} class="link-arrow shrink-0" data-reveal>
          Tüm hizmetler
          <Icon name="arrow-right" />
        </a>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
        {services.map((s, i) => <ServiceCard service={s} delay={(i % 3) * 90} />)}
      </div>
    </div>
  </section>

  <!-- ÇALIŞMA YAKLAŞIMI -->
  <section class="section on-light" aria-labelledby="surec-baslik">
    <div class="container-x">
      <SectionHeading
        id="surec-baslik"
        eyebrow="Çalışma Yaklaşımımız"
        title="Dört aşamalı, izlenebilir bir süreç"
        lead="Her çalışma, kapsamı baştan netleştirilmiş ve her adımı kayda alınan bir düzen içinde yürütülür."
        align="split"
      />
      <ol class="relative mt-16 grid gap-10 md:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-8">
        <span class="absolute top-[1.65rem] right-0 left-0 hidden h-px bg-line lg:block" aria-hidden="true"></span>
        {
          processSteps.map((step, i) => (
            <li class="group relative" data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <div class="flex items-center gap-4">
                <span class="relative z-10 inline-flex size-[3.3rem] items-center justify-center rounded-full border border-line bg-white font-display text-lg font-bold text-navy-900 transition-colors duration-500 group-hover:border-navy-900 group-hover:bg-navy-900 group-hover:text-gold-500">
                  {step.number}
                </span>
                <span class="h-px flex-1 bg-line lg:hidden" aria-hidden="true" />
              </div>
              <h3 class="h-card mt-7">{step.title}</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- BİLGİ MERKEZİ ÖNİZLEME -->
  <section class="section on-light border-t border-line bg-paper" aria-labelledby="bilgi-baslik">
    <div class="container-x">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          id="bilgi-baslik"
          eyebrow="Bilgi Merkezi"
          title="İhale süreçlerine dair rehber içerikler"
          lead="Yapım işi ihalelerinde sık karşılaşılan konuları genel çerçevesiyle ele alan bilgilendirici yazılar."
        />
        <a href={href('/bilgi-merkezi/')} class="link-arrow shrink-0" data-reveal>
          Tüm içerikler
          <Icon name="arrow-right" />
        </a>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {articles.map((a, i) => <ArticleCard article={a} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
