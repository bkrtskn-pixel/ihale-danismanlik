---
import { site } from '@/data/site';

interface Props {
  /** 'dark' = açık zemin üzerinde lacivert yazı; 'light' = koyu zemin üzerinde beyaz yazı */
  tone?: 'dark' | 'light';
  class?: string;
}

const { tone = 'dark', class: className = '' } = Astro.props;
const { primary, secondary } = site.brand.wordmark;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <svg viewBox="0 0 40 40" class="size-10 shrink-0" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="4" fill={tone === 'light' ? '#FFFFFF' : '#10243A'} fill-opacity={tone === 'light' ? '0.06' : '1'} />
    {tone === 'light' && <rect x=".5" y=".5" width="39" height="39" rx="3.5" fill="none" stroke="#FFFFFF" stroke-opacity=".18" />}
    <path d="M9 30.5h22" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" />
    <rect x="11" y="22" width="4" height="7" rx=".6" fill="#FFFFFF" />
    <rect x="18" y="18" width="4" height="11" rx=".6" fill="#FFFFFF" />
    <rect x="25" y="14" width="4" height="15" rx=".6" fill="#FFFFFF" />
    <path d="M10 17.5 27 9" stroke="#C4A46A" stroke-width="1.6" stroke-linecap="round" />
    <circle cx="28.5" cy="8.3" r="2.1" fill="#C4A46A" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[1.15rem] font-extrabold tracking-[-0.02em]', tone === 'light' ? 'text-white' : 'text-navy-900']}>
      {primary}
    </span>
    <span class:list={['mt-1 font-display text-[0.68rem] font-semibold uppercase tracking-[0.2em]', tone === 'light' ? 'text-white/60' : 'text-muted']}>
      {secondary}
    </span>
  </span>
</span>
