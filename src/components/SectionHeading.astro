---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Başlık etiketi (sayfa hiyerarşisine göre). */
  as?: 'h2' | 'h3';
  align?: 'left' | 'split';
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, as: Tag = 'h2', align = 'left', id, class: className = '' } = Astro.props;
---

<div
  class:list={[
    align === 'split' ? 'grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8' : 'max-w-3xl',
    className,
  ]}
  data-reveal
>
  <div class:list={[align === 'split' && 'lg:col-span-7']}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id} class="h-section mt-5">{title}</Tag>
  </div>
  {lead && <p class:list={['lead', align === 'split' ? 'lg:col-span-5 lg:pb-1.5' : 'mt-6']}>{lead}</p>}
</div>
